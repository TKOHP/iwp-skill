# iwp skill 配置文件示例：复制本文件为 .env 后按需修改。
# 注意：.env 是唯一外部配置来源，shell 环境变量不再被读取；
# 未列出的 KEY 均走 skill_config.py 内置默认值，零配置可用。

# MCP server 公网入口（需与 MCP server 侧配置一致）
# 形如 https://<iwp-host>；不要在此处保留任何真实内网/生产域名
MCP_PUBLIC_BASE_URL=https://<iwp-host>

# OAuth 客户端 ID（必须与服务端 MCP_ALLOWED_CLIENTS 逐字一致）
# 形如 <iwp-client-id>；不要在此处保留任何真实生产 client_id
IWP_CLIENT_ID=<iwp-client-id>

# OAuth redirect_uri（必须注册到 MCP server 的 MCP_ALLOWED_REDIRECT_URIS）
IWP_REDIRECT_URI=http://localhost:9999/callback

# 本地 OAuth 回调端口（须与 IWP_REDIRECT_URI 的端口保持一致）
IWP_LOCAL_CALLBACK_PORT=9999

# auth start 是否自动打开浏览器（1=默认开；0=仅返回 URL 由用户手动访问）
IWP_AUTO_OPEN=1

# 会话首次调用前是否顺带检查技能上游更新（1=默认开；0=完全关闭，不发任何请求）
IWP_UPDATE_CHECK=1

# 更新检测比对的上游仓库（owner/repo；默认官方仓库）
IWP_UPDATE_REPO=TKOHP/iwp-skill
